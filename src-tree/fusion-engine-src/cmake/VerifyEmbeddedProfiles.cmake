# Reassembles the adjacent raw string literals of the generated device profile source and
# compares the payload with the JSON it was generated from.
file(READ "${JSON_FILE}" expected)
file(READ "${GENERATED_FILE}" generated)
string(LENGTH "${expected}" expected_length)
string(FIND "${generated}" "R\"ninfer_json(" start)
string(FIND "${generated}" ")ninfer_json\"" end REVERSE)
if(start EQUAL -1 OR end EQUAL -1)
  message(FATAL_ERROR "generated device profiles source has no raw-string payload")
endif()
math(EXPR start "${start} + 14")
math(EXPR payload_length "${end} - ${start}")
if(payload_length LESS 0)
  message(FATAL_ERROR "generated device profiles source has a malformed raw-string payload")
endif()
string(SUBSTRING "${generated}" ${start} ${payload_length} payload)
string(REPLACE ")ninfer_json\" R\"ninfer_json(" "" payload "${payload}")
if(NOT "${payload}" STREQUAL "${expected}")
  message(FATAL_ERROR "embedded device profiles differ from device_profiles.json")
endif()
message(STATUS "embedded device profiles: byte-identical (${expected_length} bytes)")
